@model wildrydes.net.Models.UnicornModel

@{
    ViewBag.Title = "Create";
}

<style>
    input {
        max-width: 700px;
    }

    textarea {
        max-width: 700px;
    }

    label {
        color: #ffffff;
        font-weight: bold;
        font-style: italic;
        padding-bottom: 10px;
        font-size: 18px;
    }

    #Name {
        width: 600px;
        height: 50px;
        background-color: #ffffff;
        border-bottom: 3px solid #000000;
        text-align: center;
    }

    #Description {
        width: 600px;
        height: 100px;
        background-color: #ffffff;
        border-bottom: 3px solid #000000;
        text-align: center;
    }

    #list {
        color: #ffffff;
        font-weight: bold;
        font-style: italic;
        padding-top: 10px;
    }
</style>

<form asp-controller="Unicorn" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="form-horizontal" style="margin: auto; text-align: center;">
        <h3 style="padding-top: 75px; color: #ffffff; font-weight: bold; font-style: italic;">Register Unicorn</h3>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group" style="padding-top: 75px; margin: auto; text-align: center;">
            <label asp-for="Name" class="control-label col-md-2"></label>
            <div class="col-md-10" style="margin: auto; text-align: center;">
                <input asp-for="Name" class="form-control" />
                <br />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group" style="padding-top: 75px; margin: auto; text-align: center;">
            <label asp-for="Description" class="control-label col-md-2"></label>
            <div class="col-md-10" style="margin: auto; text-align: center;">
                <textarea asp-for="Description" class="form-control"></textarea>
                <br />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group" style="padding-top: 20px; padding-bottom: 100px; margin: auto; text-align: center;">
            <div class="col-md-offset-2 col-md-10" style="margin: auto; text-align: center;">
                <input type="submit" value="Create" class="btn btn-primary btn-md" />
            </div>
            <div id="list">
                <a asp-action="Index">Back to List</a>
            </div>
        </div>
    </div>
</form>
