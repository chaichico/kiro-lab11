@{
    var user = User.Identity?.IsAuthenticated == true ? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value : null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Wild Rydes</a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link" asp-controller="Ride" asp-action="Map">Request a Ride</a></li>
                    <li><a class="nav-link" asp-controller="Unicorn" asp-action="Index">Our Unicorns</a></li>
                </ul>
                <ul class="navbar-nav">
                    @if (string.IsNullOrEmpty(user))
                    {
                        <li><a class="nav-link" asp-controller="User" asp-action="Login">Login</a></li>
                        <li><a class="btn btn-outline-primary" asp-controller="User" asp-action="Create">Register</a></li>
                    }
                    else
                    {
                        <li><a class="nav-link" asp-controller="Ride" asp-action="Index">Ride History</a></li>
                        <li><a class="btn btn-outline-primary" asp-controller="User" asp-action="Logout">Logout</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        <section class="row" aria-labelledby="aspnetTitle">
            <img src="~/images/wr-logo-white.png" style="width: 50%; height: auto; margin: auto; padding-top: 75px;" />
        </section>
            @RenderBody()
            <hr />
            <footer>
                <p>&copy; @DateTime.Now.Year - Wild Rydes</p>
            </footer>
    </div>

    <script src="~/js/jquery-3.7.1.js"></script>
    <script src="~/js/bootstrap.bundle.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
