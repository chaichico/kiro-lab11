@{
    ViewBag.Title = "Request a Ride";
}

<div class="row" style="margin: auto; text-align: center;">
    <h3 style="padding-top: 75px; color: #ffffff; font-weight: bold; font-style: italic;">Request a Ride</h3>
    <div class="col-md-4">
        <div class="card" style="padding-top: 75px;">
            <div class="card-body">
                <div id="rideForm">
                    <h5 class="card-title">Trip Details</h5>
                    <div class="form-group mb-3">
                        <label for="pickupAddress">Pickup Location</label>
                        <input type="text" class="form-control" id="pickupAddress" placeholder="Getting your location..." readonly>
                    </div>
                    <div class="form-group mb-3">
                        <label for="destinationAddress">Destination</label>
                        <input type="text" class="form-control" id="destinationAddress" placeholder="Enter destination">
                    </div>
                    <div class="form-group mb-3">
                        <label for="passengers">Number of Passengers</label>
                        <select class="form-control" id="passengers">
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-primary btn-md" onclick="requestRide()">Request Ride</button>
                </div>

                <div id="rideConfirmation" style="display: none;">
                    <h5 class="card-title">Ride Confirmed!</h5>
                    <div class="alert alert-success">
                        <h6>Your ride has been requested successfully</h6>
                        <p><strong>Ride ID:</strong> <span id="confirmedRideId"></span></p>
                        <p><strong>Unicorn:</strong> <span id="confirmedUnicorn"></span></p>
                        <p><strong>Color:</strong> <span id="confirmedUnicornColor"></span></p>
                        <p><strong>Description:</strong> <span id="confirmedUnicornDesc"></span></p>
                        <p><strong>Estimated Pickup:</strong> <span id="confirmedPickupTime"></span></p>
                    </div>
                    <button type="button" class="btn btn-danger me-2" onclick="cancelRide()">Cancel Ride</button>
                    <button type="button" class="btn btn-secondary" onclick="requestNewRide()">Request Another Ride</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div id="map" style="height: 500px; width: 100%;"></div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />

<script>
    var map = L.map('map').setView([47.6062, -122.3321], 12);
    var pickupMarker, destinationMarker, unicornMarker;
    var pickupCoords = null;
    var destCoords = null;
    var unicornInterval = null;

    L.tileLayer('/Ride/GetMapTile/{z}/{x}/{y}', {
        attribution: '© Amazon Web Services',
        maxZoom: 18
    }).addTo(map);

    initializeMapFeatures();

    function initializeMapFeatures() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var lat = position.coords.latitude;
                var lng = position.coords.longitude;
                map.setView([lat, lng], 12);

                $.ajax({
                    url: '/Ride/ReverseGeocode',
                    type: 'POST',
                    data: { lat: lat, lng: lng },
                    success: function(response) {
                        var address = response.success ? response.address : lat.toFixed(4) + ', ' + lng.toFixed(4);
                        document.getElementById('pickupAddress').value = address;
                        pickupCoords = { lat: lat, lng: lng };
                        pickupMarker = L.marker([lat, lng])
                            .addTo(map)
                            .bindPopup('Pickup: ' + address);
                    },
                    error: function() {
                        var coords = lat.toFixed(4) + ', ' + lng.toFixed(4);
                        document.getElementById('pickupAddress').value = coords;
                        pickupCoords = { lat: lat, lng: lng };
                        pickupMarker = L.marker([lat, lng])
                            .addTo(map)
                            .bindPopup('Pickup: ' + coords);
                    }
                });
            }, function(error) {
                console.log('Geolocation error:', error.message);
                document.getElementById('pickupAddress').placeholder = 'Location access denied';
            });
        } else {
            document.getElementById('pickupAddress').placeholder = 'Geolocation not supported';
        }

        map.on('click', function(e) {
            var lat = e.latlng.lat;
            var lng = e.latlng.lng;

            $.ajax({
                url: '/Ride/ReverseGeocode',
                type: 'POST',
                data: { lat: lat, lng: lng },
                success: function(response) {
                    var address = response.success ? response.address : lat.toFixed(4) + ', ' + lng.toFixed(4);
                    if (destinationMarker) { map.removeLayer(destinationMarker); }
                    destinationMarker = L.marker([lat, lng])
                        .addTo(map)
                        .bindPopup('Destination: ' + address)
                        .openPopup();
                    document.getElementById('destinationAddress').value = address;
                    destCoords = { lat: lat, lng: lng };
                },
                error: function() {
                    var coords = lat.toFixed(4) + ', ' + lng.toFixed(4);
                    if (destinationMarker) { map.removeLayer(destinationMarker); }
                    destinationMarker = L.marker([lat, lng])
                        .addTo(map)
                        .bindPopup('Destination: ' + coords)
                        .openPopup();
                    document.getElementById('destinationAddress').value = coords;
                    destCoords = { lat: lat, lng: lng };
                }
            });
        });
    }

    function requestRide() {
        var pickup = document.getElementById('pickupAddress').value;
        var destination = document.getElementById('destinationAddress').value;
        var passengers = document.getElementById('passengers').value;

        if (!pickup || !destination || !pickupCoords || !destCoords) {
            alert('Please ensure both pickup and destination locations are set');
            return;
        }

        $.ajax({
            url: '/Ride/CreateRide',
            type: 'POST',
            data: {
                pickupLat: pickupCoords.lat,
                pickupLng: pickupCoords.lng,
                pickupAddress: pickup,
                destLat: destCoords.lat,
                destLng: destCoords.lng,
                destAddress: destination,
                passengers: passengers
            },
            success: function(response) {
                if (response.success) {
                    document.getElementById('rideForm').style.display = 'none';
                    document.getElementById('rideConfirmation').style.display = 'block';
                    document.getElementById('confirmedRideId').textContent = response.rideId;
                    document.getElementById('confirmedUnicorn').textContent = response.unicornName;
                    document.getElementById('confirmedUnicornColor').textContent = response.unicornColor;
                    document.getElementById('confirmedUnicornDesc').textContent = response.unicornDesc;
                    var pickupTime = new Date();
                    pickupTime.setSeconds(pickupTime.getSeconds() + 15);
                    document.getElementById('confirmedPickupTime').textContent = pickupTime.toLocaleTimeString();
                    placeUnicornAndStartTracking(response.unicornName);
                } else {
                    alert('Error requesting ride: ' + response.error);
                }
            },
            error: function() {
                alert('Failed to request ride. Please try again.');
            }
        });
    }

    function requestNewRide() {
        if (unicornInterval) { clearInterval(unicornInterval); unicornInterval = null; }
        if (unicornMarker) { map.removeLayer(unicornMarker); unicornMarker = null; }
        document.getElementById('rideForm').style.display = 'block';
        document.getElementById('rideConfirmation').style.display = 'none';
        document.getElementById('destinationAddress').value = '';
        destCoords = null;
        if (destinationMarker) { map.removeLayer(destinationMarker); destinationMarker = null; }
        document.getElementById('passengers').value = '1';
    }

    function cancelRide() {
        if (confirm('Are you sure you want to cancel this ride?')) {
            if (unicornInterval) { clearInterval(unicornInterval); unicornInterval = null; }
            requestNewRide();
        }
    }

    function placeUnicornAndStartTracking(unicornName) {
        if (!pickupCoords) return;
        var distance = 0.05 + Math.random() * 0.05;
        var angle = Math.random() * 2 * Math.PI;
        var unicornLat = pickupCoords.lat + distance * Math.cos(angle);
        var unicornLng = pickupCoords.lng + distance * Math.sin(angle);

        var unicornIcon = L.icon({
            iconUrl: '/images/unicorn-icon.png',
            iconSize: [40, 40],
            iconAnchor: [20, 20],
            popupAnchor: [0, -20]
        });

        unicornMarker = L.marker([unicornLat, unicornLng], { icon: unicornIcon })
            .addTo(map).bindPopup(unicornName + ' is on the way!');

        var steps = 30;
        var currentStep = 0;
        var latStep = (pickupCoords.lat - unicornLat) / steps;
        var lngStep = (pickupCoords.lng - unicornLng) / steps;

        unicornInterval = setInterval(function() {
            currentStep++;
            var newLat = unicornLat + (latStep * currentStep);
            var newLng = unicornLng + (lngStep * currentStep);
            unicornMarker.setLatLng([newLat, newLng]);
            if (currentStep >= steps) {
                clearInterval(unicornInterval);
                unicornMarker.bindPopup(unicornName + ' has arrived!').openPopup();
            }
        }, 500);
    }
</script>
